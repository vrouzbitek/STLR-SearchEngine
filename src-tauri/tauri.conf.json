{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STLR Search",
  "version": "0.3.7",
  "identifier": "com.stlr.searchengine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "STLR Search",
        "width": 680,
        "height": 72,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "backgroundColor": "#00000000",
        "visible": false
      },
      {
        "label": "settings",
        "create": false,
        "title": "STLR Search · Settings",
        "width": 620,
        "height": 760,
        "minWidth": 520,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0d0d12"
      },
      {
        "label": "wizard",
        "create": false,
        "title": "Welcome to STLR Search",
        "width": 600,
        "height": 760,
        "minWidth": 520,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0d0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "mainBinaryName": "stlr-search",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "vrouz",
    "copyright": "© 2026 vrouz · MIT",
    "shortDescription": "Self-learning, keyboard-first Windows launcher",
    "resources": {
      "../extension/": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0RjExNEI4ODkzMDQ0OTYKUldTV1JEQ0p1QlR4MUxISnR0SUVpTmtFcXNySi94clVEbE1JZWVnZmRFYlFmUy9PMWxPbVFBbVYK",
      "endpoints": ["https://github.com/vrouzbitek/STLR-SearchEngine/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
